flip:{[f]{[x;y]f[y;x]}} // Swap a binary function's arguments.
enlist:{[x],x} // Wrap one value in a list.
delta2:{[x]$.[#x<=1;@r x];t:alloc(#x-1);N[#t;t _n:x(_n+1)-x _n];t} // Adjacent differences.
join:{[d;xs]fold[xs;{x,d,y}]} // Join items with a delimiter.
mapidx:{[xs;f]r:alloc #xs;N[#xs;r _n:f[xs _n;_n]];r} // Map values with their index.
enumerate:{[xs]mapidx[xs;{[v;i](i;v)}]} // Pair each value with its index.
keepidx:{[xs;f]r:();N[#xs;v:xs _n;$.[f[v;_n];r,:,v]];r} // Keep values by value and index.
partition:{[xs;f]yes:();no:();N[#xs;v:xs _n;$[f v;yes,:,v;no,:,v]];(yes;no)} // Split values by predicate result.
take:{[xs;n]l:#xs;$[n<0;xs[max[0;l+n]..l];xs[0..min[l;n]]]} // Take n items, or from the end when n is negative.
drop:{[xs;n]l:#xs;$[n<0;xs[0..max[0;l+n]];xs[min[l;n]..l]]} // Drop n items, or from the end when n is negative.
chunks:{[xs;n]$.[n<=0;raise"chunks: size must be positive"];r:();i:0;l:#xs
  W[i<l;j:min[l;i+n];r,:,xs[i..j];i:j];r} // Split into non-overlapping chunks.
windows:{[xs;n]$.[n<=0;raise"windows: size must be positive"];r:();l:#xs
  $.[n>l;@r r];i:0;W[i+n<=l;r,:,xs[i..(i+n)];i+:1];r} // Return sliding windows of size n.

values:{[d]d[keys d]} // Return dict values in key order.
haskey?:{[d;k]~U kti[d;k]} // Test whether a dict has a key.
get:{[d;k;default]$[haskey?[d;k];d[k];default]} // Return a dict value or default.
indexby:{[xs;f]d:(`);N[#xs;v:xs _n;d[tag str f v]:v];d} // Build a dict keyed by f, with later values winning.
groupby:{[xs;f]groups:();N[#xs;v:xs _n;k:f v;hit:-1;i:0
    W[i<#groups;$.[groups[i][0]=k;hit:i;@b];i+:1]
    $[hit<0;groups,:,(k;,v)
      [pair:groups hit;bucket:pair 1;bucket,:,v;pair 1:bucket;groups hit:pair]]];groups} // Group values by arbitrary keys.
groupdict:{[xs;f]d:(`);N[#xs;v:xs _n;k:tag str f v
    $[haskey?[d;k];[bucket:d[k];bucket,:,v;d[k]:bucket];d[k]:,v]];d} // Group values into a dict with tag-converted keys.

memo:{[f]keys_:();vals_:();'{[arg]i:0;W[i<#keys_;$.[keys_ i=arg;@r vals_ i];i+:1]
    val:f arg;keys_,:,arg;vals_,:,val;val}} // Memoize a one-argument function.
once:{[f]done:F;val:();'{[]$[done;val;[val:f[];done:T;val]]}} // Return a thunk that runs f once.

assert:{[cond;msg]$[cond;T;raise msg]} // Raise msg unless cond is true.
assert_eq:{[got;want]$[got=want;T;raise@f"assert_eq: got {got}, want {want}"]} // Raise unless got equals want.

dumpbfn:{bfn[]|map{"\"",x,"\""}|join","|echo} // Print enabled builtin names as quoted CSV.
