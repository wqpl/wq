{
  "name": "wqide",
  "version": "0.2.0",
  "private": true,
  "description": "Interactive browser IDE for wqpl",
  "scripts": {
    "build": "npm run build:wasm && npm run build:site",
    "build:site": "vite build",
    "build:wasm": "wasm-pack build ../wq-wasm --target web",
    "build:wasm:dev": "wasm-pack build ../wq-wasm --target web --dev",
    "dev": "npm run build:wasm:dev && vite",
    "dev:site": "vite",
    "test": "node --test js/*.test.js",
    "preview": "vite preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://codeberg.org/wqpl/wq.git",
    "directory": "wqide"
  },
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://codeberg.org/wqpl/wq/issues"
  },
  "homepage": "https://wq-pl.com",
  "devDependencies": {
    "vite": "^8.0.3",
    "vite-plugin-static-copy": "^4.0.1"
  },
  "dependencies": {
    "html-to-image": "^1.11.13"
  }
}
