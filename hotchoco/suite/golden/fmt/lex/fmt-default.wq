// Lexer: tokenize strings containing + - * / and identifiers (A-Za-z0-9)

is_op:{or[x="+";x="-";x="*";x="/"]}
is_digit:{and[x>="0";x<="9"]}
is_upper:{and[x>="A";x<="Z"]}
is_lower:{and[x>="a";x<="z"]}
is_alpha:{or[is_upper x;is_lower x]}
is_id_char:{or[is_upper x;is_lower x;is_digit x]}
lex:{[s]
  tokens:();i:0;n:#s
  W[i<n;c:s i
    $$[is_op c;[tokens,:,(`op;c);i+:1]
      is_alpha c;[j:i;W[A[j<n;is_id_char s j];j+:1];tokens,:,(`id;s i..j);i:j]
      is_digit c;[j:i;W[A[j<n;is_digit s j];j+:1];tokens,:,(`int;s i..j);i:j]
      i+:1]];
  tokens}

echo "--- Test 1: basic ---"
echo lex "a+b*12"

echo "--- Test 2: identifiers and ops mixed ---"
echo lex "ABC123-xyz/9"

echo "--- Test 3: consecutive same ops ---"
echo lex "++--"

echo "--- Test 4: single identifier ---"
echo lex "helloWorld"

echo "--- Test 5: deny 1k ---"
echo lex "1k"
