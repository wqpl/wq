rpn:{[p]
  sta:();bpop:{'sta[!-2;-1]|fold x};upop:{'sta!|x};apop:{'sta[!0..#'sta]|fold x}
  p|map{
    'sta,:$$[x="+";
      'bpop (+);
      x="-";
      'bpop (-);
      x="*";
      'bpop (*);
      x="%";
      'bpop (/);
      x="_";
      'upop (-);
      x="+/";
      'apop (+);
      x]};
  sta!}

((3;4;"+";2;"*";1;"-")/* 13 */
 (3;4;"+";"_")/* -7 */
 (1;2;3;4;"+/")/* 10 */
 (10;2;3;"+/";"_")/* -15 */)|map rpn
