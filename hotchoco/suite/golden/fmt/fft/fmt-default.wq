P:-1|arccos
f:{[x]
  n:#x
  $.[n=0;raise "empty input"]
  r:,0;W[#r<n;r:r*2,r*2+1]
  $.[#r~n;raise "length must be a power of 2"]
  a:x r+0i;l:2
  W[l<=n;h:l/%2;k:0..n%l<h|where;u:a k
    v:exp (-2i*P/l*0..h)|R (n/%2)|* a[k+h]
    (a k;a[k+h]):(u+v;u-v);l*:2]
  a}
c:{[s;o]
  e:8e-15*#s*$[(m:max abs o)>0;m;1.0]
  s|M{$[e>abs (r:re x);0.0;r]+1i*$[e>abs (i:im x);0.0;i]}}
(`fft:f;`ifft:{conj f conj x|/ #x};`clean:c)
