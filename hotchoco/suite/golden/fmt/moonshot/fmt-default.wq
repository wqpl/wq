// Moonshot Delivery, a pocket-sized terminal lander game

screen_width:45
sky_height:13
gravity:1.20
main_thrust:3.05
side_thrust:0.35

positive_int:{[s]
  n:int s;$.[n<=0;raise "expected a positive integer"];n}

spec:(
  `name:"wq e/moonshot.wq --";
  `about:"Moonshot Delivery - a pocket-sized lunar lander\n\nControls:\n  w  main engine       a  thrust left       d  thrust right\n  wa main + left       wd main + right      .  coast\n  q  abandon mission\n\nLand on the === pad with vertical speed at most 3.5 and horizontal\nspeed at most 2.0. Every burn costs fuel, so elegance earns points.";
  `args:(
    (`name:`demo;`kind:`flag;`help:"let the onboard computer fly the lander");
    (`name:`plain;`kind:`flag;`help:"use compact, color-free output");
    (
      `name:`seed;
      `kind:`option;
      `parse:positive_int;
      `value_name:"N";
      `help:"replay a mission with a positive seed");
    (
      `name:`max_turns;
      `kind:`option;
      `parse:positive_int;
      `default:160;
      `value_name:"N";
      `help:"abort after N turns (default: 160)")))

options:cliargs[spec] `args
demo:options `demo
plain:options `plain
max_turns:options `max_turns
seed:$[#options `seed=0;$[demo;4242;1+rand 1000000];options `seed]
mission_rng:rng seed

clamp:{[value;low;high]max[low;min[high;value]]}

make_mission:{[]
  altitude:88+mission_rng 25
  pad_center:7+mission_rng[screen_width-14]
  (`x:5.0+mission_rng[screen_width-10];
    `y:altitude+0.0;
    `vx:(mission_rng 9-4)/10.0;
    `vy:mission_rng 9/10.0;
    `fuel:62+mission_rng 11;
    `turn:0;
    `initial_y:altitude+0.0;
    `pad:pad_center;
    `message:"Cargo seals green. Good luck, pilot.")}

command_cost:{[command]
  $$[or[command="wa";command="wd"];3
    command="w";2
    or[command="a";command="d"];1
    0]}

main_burn?:{[command]or[command="w";command="wa";command="wd"]}

lateral_burn:{[command]
  $$[or[command="a";command="wa"];-side_thrust
    or[command="d";command="wd"];side_thrust
    0.0]}

valid_command?:{[command]has?[("";".";"w";"a";"d";"wa";"wd";"q");command]}

autopilot_command:{[state]
  altitude:max[0.0;state `y]
  error:state `pad-state `x
  speed_limit:$[altitude<18.0;0.65;1.45]
  desired_vx:clamp[error*0.19;-speed_limit;speed_limit]
  horizontal:$$[state `vx>desired_vx+0.16;"a"
    state `vx<desired_vx-0.16;"d"
    ""]
  next_vy:state `vy+gravity
  landing_next?:altitude-next_vy<=0.0
  desired_vy:clamp[0.72*sqrt altitude;3.0;7.2]
  // Commit to a safe coast touchdown instead of hovering over the pad.
  vertical?:and[not[and[landing_next?;next_vy<=3.5]];next_vy>desired_vy]
  $$[and[vertical?;horizontal="a"];"wa"
    and[vertical?;horizontal="d"];"wd"
    vertical?;"w"
    horizontal="";"."
    horizontal]}

advance:{[state;requested_command]
  cost:command_cost requested_command
  command:$[cost<=state `fuel;requested_command;"."]
  new_vx:0.985*(state `vx+lateral_burn command)
  new_vy:state `vy+gravity+$[main_burn? command;-main_thrust;0.0]
  state `x:state `x+new_vx
  state `y:state `y-new_vy
  state `vx:new_vx
  state `vy:new_vy
  state `fuel:state `fuel-command_cost command
  state `turn:state `turn+1
  state `message:$$[and[cost>0;command="."];"Fuel tank coughed: burn cancelled."
    command=".";"Coasting through the silver quiet."
    main_burn? command;"Main engine paints a blue-white plume."
    "Side thruster nudges the cargo home."]
  (state;command)}

esc:"\x1b"
ansi:{[code;text]$[plain;text;esc,"[",code,"m",text,esc,"[0m"]}

star_at?:{[row;column;turn](row*37+column*17+turn*3+seed)%67=0}

sky_line:{[state;row;lander_row;lander_column]
  line:repeat[" ";screen_width]
  N[screen_width;$.[star_at?[row;_n;state `turn];line _n:@u"."]]
  $.[row=lander_row
    left:clamp[lander_column-1;0;screen_width-3]
    line left:@u"/"
    line[left+1]:@u"A"
    line[left+2]:@u"\\"];
  line}

ground_line:{[state]
  line:repeat["_";screen_width];left:state `pad-3
  N[7;column:left+_n
    $.[and[column>=0;column<screen_width];line column:@u"="]];
  line}

render:{[state]
  $.[not plain;print[esc;"[2J";esc;"[H"]]
  progress:1.0-max[0.0;state `y]/state `initial_y
  lander_row:int round clamp[progress*(sky_height-1);0;sky_height-1]
  lander_column:int round clamp[state `x;1;screen_width-2]
  title:ansi["1;36";"MOONSHOT DELIVERY"]
  echo@f"{title}  mission seed {seed}  turn {state `turn}"
  echo@f"alt {[>6.1]max[0.0;state `y]}   fall {[>5.2]state `vy}   drift {[>6.2]state `vx}   fuel {[>2]state `fuel}"
  $.[not plain
    N[sky_height;echo ("|",sky_line[state;_n;lander_row;lander_column],"|")]
    echo ("+",ansi["1;33";ground_line state],"+")
    echo (" ",state `message)]}

lower_ascii:{[s]
  s|map{
    c:x;o:ord c;$[and[o>=65;o<=90];chr[o+32];c]}}

read_command:{[]
  W[T;line:input "burn [w/a/d/wa/wd/. or q] > "
    $.[#line=0;@r "q"]
    command:lower_ascii line
    $.[valid_command? command;@r $[command="";".";command]]
    echo "Flight computer: command not understood."]}

landed_on_pad?:{[state]abs[state `x-state `pad]<=3.5}

safe_landing?:{[state]and[landed_on_pad? state;state `vy<=3.5;abs state `vx<=2.0]}

mission_result:{[state]
  safe?:safe_landing? state
  gentle?:and[safe?;state `vy<=1.8;abs state `vx<=0.8]
  accuracy:max[0;int round (250-45*abs[state `x-state `pad])]
  score:$[safe?;500+15*state `fuel+accuracy+$[gentle?;350;0];0]
  echo ""
  crunch:ansi["1;31";"CRUNCH!"]
  $$[gentle?;echo (ansi["1;32";"VELVET LANDING!"]," The moon barely noticed.")
    safe?;echo (ansi["1;32";"LANDED!"]," Cargo delivered with all the important pieces attached.")
    not landed_on_pad? state;
    echo@f"{crunch} You missed the pad by {[.1]abs[state `x-state `pad]} meters."
    echo@f"{crunch} Impact speed was {[.2]state `vy}. The cargo is now modern art."]
  echo@f"Final: x {[.2]state `x} / pad {state `pad}, fall {[.2]state `vy}, drift {[.2]state `vx}, fuel {state `fuel}, score {score}"
  $[safe?;0;1]}

run_mission:{[]
  state:make_mission[]
  W[T;render state
    $$[state `y<=0.0;@r mission_result state
      state `turn>=max_turns;[echo "\nMission timed out in orbit.";@r 1]
      or[state `x<-8.0;state `x>screen_width+8.0];
      [echo "\nThe lander drifted beyond the tracking horizon.";@r 1]
      [command:$[demo;autopilot_command state;read_command[]]
        $.[command="q";echo "\nMission abandoned. The cargo sends a disappointed beep.";@r 130]
        $.[plain;echo@f"  command {command}"]
        advanced:advance[state;command]
        state:advanced 0]]]}

run_mission[]
