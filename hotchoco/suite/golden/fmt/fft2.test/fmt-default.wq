(`fft2;`ifft2):@i"fft2.wq"
impulse:fft2 (0;0;1;0;0;0;0;0)
assert_eq[
  impulse;
  (1+0i;-1i;-1+0i;1i;1+0i;-1i;-1+0i;1i);
  "impulse"]
echo impulse
alternating:fft2 (1;0;-1;0;1;0;-1;0)
assert_eq[
  alternating;
  (0+0i;0+0i;4+0i;0+0i;0+0i;0+0i;4+0i;0+0i);
  "alternating signal"]
echo alternating
round_trip:ifft2 fft2 (1;2;3;4)
assert_eq[round_trip;(1+0i;2+0i;3+0i;4+0i);"round trip"]
echo round_trip
