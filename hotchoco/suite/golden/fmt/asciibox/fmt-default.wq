asciibox_:{[lines]
  (maxlen;i):alloc 2;
  N[#lines;len_:#lines i
    $.[len_>maxlen;maxlen:len_];i+:1];
  pad:1;
  width:maxlen+pad*2
  border:"+",repeat["-";width],"+";echo border;i:0
  N[#lines;l:lines i;spaces:maxlen-#l
    echo ("|",repeat[" ";pad],l,repeat[" ";pad+spaces],"|");i+:1]
  echo border}
asciibox:{asciibox_ split x}
read_text:{open x|read|decode "utf-8"}
split_lines:{
  lines:split[x;"\n"]
  $.[and[#lines>0;U lines[-1]];lines!];lines}
asciibox_file:{asciibox_ split_lines read_text x}
