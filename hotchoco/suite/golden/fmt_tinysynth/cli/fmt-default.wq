// Command-line wrapper for e/tinysynth/tinysynth.wq.

synth:@i"tinysynth.wq"
(`parse_score;`synthesize;`normalize_frames;`write_wav):synth

positive_sample_rate:{[value]
  parsed:@t int value
  $.[not[parsed 0=`ok];raise "sample rate must be an int"]
  rate:parsed 1
  $.[or[rate<8000;rate>192000];raise "sample rate must be between 8000 and 192000 Hz"]
  rate}

unit_gain:{[value]
  parsed:@t float value
  $.[not[parsed 0=`ok];raise "gain must be a number"]
  gain:parsed 1
  $.[or[gain<0.0;gain>1.0];raise "gain must be between 0 and 1"]
  gain}

preview_seconds:{[value]
  parsed:@t float value
  $.[not[parsed 0=`ok];raise "preview must be a number"]
  seconds:parsed 1
  $.[or[seconds<=0.0;seconds>3600.0];raise "preview must be greater than 0 and at most 3600 seconds"]
  seconds}

noise_seed:{[value]
  parsed:@t int value
  $.[not[parsed 0=`ok];raise "seed must be an int"]
  seed:parsed 1
  $.[or[seed<0;seed>2147483647];raise "seed must be between 0 and 2147483647"]
  seed}

spec:(
  `name:"wq e/tinysynth/cli.wq --";
  `version:"1.0";
  `about:"Render a TinySynth score as a stereo 16-bit PCM WAV file.";
  `args:(
    (`name:`input;`kind:`positional;`required:T;`value_name:"SCORE";`help:"TinySynth score file");
    (
      `name:`output;
      `kind:`positional;
      `default:"out.wav";
      `value_name:"WAV";
      `help:"output path (default: out.wav)");
    (
      `name:`sample_rate;
      `kind:`option;
      `short:"r";
      `parse:positive_sample_rate;
      `default:44100;
      `value_name:"HZ";
      `help:"sample rate from 8000 through 192000 (default: 44100)");
    (
      `name:`gain;
      `kind:`option;
      `short:"g";
      `parse:unit_gain;
      `default:0.85;
      `value_name:"LEVEL";
      `help:"master gain from 0 through 1 (default: 0.85)");
    (
      `name:`preview;
      `kind:`option;
      `short:"p";
      `parse:preview_seconds;
      `value_name:"SECONDS";
      `help:"render at most the first SECONDS of audio");
    (
      `name:`seed;
      `kind:`option;
      `short:"s";
      `parse:noise_seed;
      `value_name:,"N";
      `help:"override deterministic event seeds");
    (`name:`normalize;`kind:`flag;`short:"n";`help:"normalize the rendered peak to 0.95");
    (`name:`dump_events;`kind:`flag;`short:"d";`help:"print parsed event timing and voice settings");
    (`name:`quiet;`kind:`flag;`short:"q";`help:"do not print the render summary")))

options:cliargs[spec] `args

read_score:{[path]
  stream:open $[path=,"-";"/dev/stdin";path]
  bytes:read stream
  close stream
  decode[bytes;"utf-8"]}

override_seeds:{[events;seed]
  N[#events;
    event:events _n
    event `seed:seed+_n
    events _n:event]
  events}

preview_events:{[events;seconds]
  preview:()
  N[#events;
    event:events _n
    $.[event `start<seconds
      remaining:seconds-event `start
      $.[event `seconds>remaining;event `seconds:remaining]
      preview:preview,(,event)]]
  preview}

dump_events:{[events]
  N[#events;
    event:events _n
    echo fmt[
      "event {}: track={} start={}s duration={}s token={} wave={} pan={}";
      _n+1;
      event `track;
      round[event `start;4];
      round[event `seconds;4];
      event `token;
      event `wave;
      event `pan]]}

sample_stats:{[samples;gain]
  scaled:flatten samples*gain
  peak:$[#scaled=0;0.0;max abs scaled]
  clipped:0
  N[#scaled;$.[abs scaled _n>1.0;clipped+:1]]
  (`peak:peak;`clipped:clipped)}

$.[and[options `output=,"-";options `dump_events]
  raise "cannot dump events while writing WAV data to standard output"]

source:read_score options `input
events:parse_score source
$.[#options `seed>0;events:override_seeds[events;options `seed]]
$.[options `dump_events;dump_events events]
$.[#options `preview>0;events:preview_events[events;options `preview]]

samples:synthesize[events;options `sample_rate]
$.[#options `preview>0
  preview_count:min[#samples;int round[options `preview*options `sample_rate]]
  samples:samples 0..preview_count]
$.[options `normalize;samples:normalize_frames[samples;0.95]]

stats:sample_stats[samples;options `gain]
byte_count:write_wav[options `output;samples;options `sample_rate;options `gain]

$.[and[not options `quiet;not[options `output=,"-"]]
  echo fmt[
    "wrote {} bytes to {} ({} events, {} seconds, {} Hz, peak {}, {} clipped samples)";
    byte_count;
    options `output;
    #events;
    round[#samples/options `sample_rate;2];
    options `sample_rate;
    round[stats `peak;4];
    stats `clipped]]
