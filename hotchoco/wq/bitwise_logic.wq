// boolean and
A[true;true] |echo
A[true;false] |echo
A[false;true] |echo

// boolean or
O[true;true] |echo
O[true;false] |echo
O[false;false] |echo

// bitwise and
band[5;3] |echo

// bitwise or
bor[5;3] |echo

// left shift
1 << 3 |echo

// right shift
8 >> 2 |echo

// bitwise xor
xor[5;3] |echo

// floor division
7 /% 3 |echo
-7 /% 3 |echo

// unary not / bitwise not
~true |echo
~false |echo
~5 |echo

// builtin call form
and[true;true;false] |echo
or[false;true;false] |echo
band[5;3;1] |echo
bor[5;3;1] |echo
<<[1;2;3] |echo
>>[32;2;1] |echo
xor[5;3;1] |echo
/%[7;3] |echo

// named logical calls
((not 5)=~5) |echo
(and[false;1]) |echo
(or[true;1]) |echo
(xor[5;3;1]=7) |echo
(band[5;3;1]=1) |echo
(bor[5;3;1]=7) |echo
(shl[1;2;3]=<<[1;2;3]) |echo
(shr[32;2;1]=>>[32;2;1]) |echo

// atom short-circuit
A[false;true] |echo
O[true;false] |echo

// list broadcasting
l1:(true;false;true)
l2:(false;true;true)
A[l1;l2] |echo
O[l1;l2] |echo

// precedence: shift before add
1 + 2 << 3 |echo

// explicit lazy nesting
O[true;A[false;false]] |echo

// explicit update
a:5
a:band[a;3]
a |echo
b:5
b:xor[b;3]
b |echo
