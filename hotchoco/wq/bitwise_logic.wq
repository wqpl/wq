// boolean and
true &| true |echo
true &| false |echo
false &| true |echo

// boolean or
true \| true |echo
true \| false |echo
false \| false |echo

// bitwise and
5 & 3 |echo

// bitwise or
5 \ 3 |echo

// left shift
1 << 3 |echo

// right shift
8 >> 2 |echo

// bitwise xor
5 ^\ 3 |echo

// floor division
7 /% 3 |echo
-7 /% 3 |echo

// unary not / bitwise not
~true |echo
~false |echo
~5 |echo

// builtin call form
&|[true;true;false] |echo
\|[false;true;false] |echo
&[5;3;1] |echo
\[5;3;1] |echo
<<[1;2;3] |echo
>>[32;2;1] |echo
^\[5;3;1] |echo
/%[7;3] |echo

// scalar short-circuit (value-level)
false &| true |echo
true \| false |echo

// list broadcasting
l1:(true;false;true)
l2:(false;true;true)
l1 &| l2 |echo
l1 \| l2 |echo

// precedence: shift before add
1 + 2 << 3 |echo

// precedence: bool and before bool or
true \| false &| false |echo

// augmented assignment
a:5
a &: 3
a |echo
b:5
b ^\: 3
b |echo
