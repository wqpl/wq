a:(1;(2;3);(4;(5;6)))
b:(10;(20;30);(40;(50;60)))
echo2:{echo (x;y)}

// MAP, default depth=1
// Expected: 1 (2;3) (4;(5;6))
map[a;echo];echo()
map[a;echo;1];echo()

// Expected: 1 2 3 4 (5;6)
map[a;echo;2];echo()

// Expected: 1 2 3 4 5 6
map[a;echo;3];echo()
map[a;echo;4];echo()
map[a;echo;inf];echo()

// MAP, depth=-inf: apply f to the root only
// Expected: (1;(2;3);(4;(5;6)))
map[a;echo;0];echo()

// MAP, negative depth
// Expected (same as depth=2): 1 2 3 4 (5;6)
map[a;echo;-1];echo()

// Expected (same as depth=0): (1;(2;3);(4;(5;6)))
map[a;echo;-99];echo()
map[a;echo;-inf];echo()

// ZIPW, default depth=1
// Expected: (1;10) ((2;3);(20;30)) ((4;(5;6));(40;(50;60)))
zipw[a;b;echo2];echo()
zipw[a;b;echo2;1];echo()

// Expected: (1;10) (2;20) (3;30) (4;40) ((5;6);(50;60))
zipw[a;b;echo2;2];echo()

// Expected: (1;10) (2;20) (3;30) (4;40) (5;50) (6;60)
zipw[a;b;echo2;3];echo()
zipw[a;b;echo2;4];echo()
zipw[a;b;echo2;inf];echo()

// Expected: ((1;(2;3);(4;(5;6)));(10;(20;30);(40;(50;60))))
zipw[a;b;echo2;0];echo()

// Expected: (1;10) (2;20) (3;30) (4;40) ((5;6);(50;60))
zipw[a;b;echo2;-1];echo()

// Expected (same as depth=0): ((1;(2;3);(4;(5;6)));(10;(20;30);(40;(50;60))))
zipw[a;b;echo2;-inf];echo()

// ANY / ALL
data:(1;2;3;4;5)
echo any[data;{x%2=0}]
echo all[data;{x%2=0}]
echo any[data;{x>10}]
echo all[data;{x>0}]

// any/all with depth
m:((1;2);(3;4))
echo any[m;{x>2};2]
echo all[m;{x>0};2]
echo any[m;{x>10};2]
echo all[m;{x>2};2]

// RSCAN
echo rscan[(1;2;3);+]
echo rscan[1..3;+]
echo rscan[(1;2;3);+;10]

// ZIP
echo zip[(1;2;3);(4;5;6)]
echo zip[(1;2;3);(4;5;6);1]
echo zip[(1;(2;3));(4;(5;6));2]

// FINDWITH / RFINDWITH
d:(1;2;3;2;4)
echo findwith[d;{x=2}]
echo findwith[d;{x=2};inf]
echo rfindwith[d;{x=2}]
echo rfindwith[d;{x=2};inf]

// RFIND
echo rfind[d;2]
echo rfind[d;2;inf]
