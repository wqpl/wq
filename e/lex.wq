// Lexer: tokenize ASCII letter-start identifiers, ints, and + - * /

is_op:{or[x=@u"+";x=@u"-";x=@u"*";x=@u"/"]}
is_digit:{and[x>=@u"0";x<=@u"9"]}
is_upper:{and[x>=@u"A";x<=@u"Z"]}
is_lower:{and[x>=@u"a";x<=@u"z"]}
is_alpha:{or[is_upper x;is_lower x]}
is_id_char:{or[is_upper x;is_lower x;is_digit x]}
lex:{[s]tokens:();i:0;n:#s
  W[i<n;c:s i
    $$[is_op c;[tokens,:,(`op; c);i+:1]
      is_alpha c;[j:i;W[A[j<n;is_id_char s j];j+:1];tokens,:,(`id;s[i..j]);i:j]
      is_digit c;[j:i;W[A[j<n;is_digit s j];j+:1];  tokens,:,(`int;s[i..j]);i:j]
      i+:1]];tokens}
lex
