pop:{x[0..#x-1]}
rpn:{[expr]sta:();N[#expr;tok:expr _n;plu:tok="+";mi_:tok="-";mul:tok="*";div:tok="%"
    $.[plu;b:sta[-1];sta:pop sta;a:sta[-1];sta:pop sta;sta:sta,a+b;@c]
    $.[mi_;b:sta[-1];sta:pop sta;a:sta[-1];sta:pop sta;sta:sta,a-b;@c]
    $.[mul;b:sta[-1];sta:pop sta;a:sta[-1];sta:pop sta;sta:sta,a*b;@c]
    $.[div;b:sta[-1];sta:pop sta;a:sta[-1];sta:pop sta;sta:sta,a/b;@c]
    sta:sta,tok];sta[-1]}
//echo rpn(3;4;"+";2;"*";1;"-")
