buildmap:{[code]jump:alloc(l:#code);stack:()
  N[l;ch:code _n;$.[ch=@u"[";stack,:_n]
    $.[ch=@u"]";open_:stack[-1];(stack;jump open_;jump _n):(stack[!];_n;open_)]];jump}
bf:{[code]tape:alloc 30000;ptr:0;jump:buildmap code;ip:0;
  W[ip<#code;op:code ip
    $.[op=@u">";ptr+:1;$.[ptr>=#tape;tape,:0]]
    $.[op=@u"<";ptr-:1;$.[ptr<0;tape:0,tape;ptr:0]]
    $.[op=@u"+";tape ptr+:1]
    $.[op=@u"-";tape ptr-:1]
    $.[op=@u".";print chr tape ptr]
    $.[op=@u",";inp:input"[bf] ";tape ptr:$[#inp>0;ord inp 0;0];echo@f"tape[ptr]={tape ptr}"]
    $.[op=@u"[";$.[tape ptr=0;ip:jump ip]]
    $.[op=@u"]";$.[tape ptr~0;ip:jump ip]];ip+:1];echo""}
bf
