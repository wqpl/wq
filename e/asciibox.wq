!p
asciibox:{[path]fh:open path;lines:"";line:freadtln fh
  W[not unit? line;lines:lines,enlist line;line:freadtln fh];fclose fh
  maxlen:0;i:0;N[#lines;len_:#lines[i];$.[len_>maxlen;maxlen:len_];i:i+1]
  pad:1;width:maxlen+pad*2;border:"+",repeat["-"; width],"+";echo border;i:0
  N[#lines;l:lines i;spaces:maxlen-#l
    echo ("|",repeat[" "; pad],l,repeat[" ";pad+spaces],"|");i:i+1]
  echo border}
