// TinySynth: parse compact music notation and render mono 16-bit PCM WAV data.

tau:6.283185307179586
wave_names:("sine";"square";"saw";"triangle")

parse_int_value:{[value;context]
  parsed:@t int value
  $[parsed 0=`ok;parsed 1;raise fmt["invalid {} '{}': expected an int";context;value]]}

parse_float_value:{[value;context]
  parsed:@t float value
  $[parsed 0=`ok;parsed 1;raise fmt["invalid {} '{}': expected a number";context;value]]}

parse_int_between:{[value;context;low;high]
  result:parse_int_value[value;context]
  $.[or[result<low;result>high]
    raise fmt["invalid {} '{}': expected {} through {}";context;value;low;high]]
  result}

parse_float_between:{[value;context;low;high]
  result:parse_float_value[value;context]
  $.[or[result<low;result>high]
    raise fmt["invalid {} '{}': expected {} through {}";context;value;low;high]]
  result}

note_frequency:{[name]
  size:#name
  $.[or[size<2;size>3]
    raise fmt["invalid note '{}': expected A0 through G#8 or a flat equivalent";name]]

  letter:name 0
  semitone:$$[
    letter=@u"C";0
    letter=@u"D";2
    letter=@u"E";4
    letter=@u"F";5
    letter=@u"G";7
    letter=@u"A";9
    letter=@u"B";11
    raise fmt["invalid note '{}': pitch names use uppercase A through G";name]]

  accidental:0
  octave_index:1
  $.[size=3
    mark:name 1
    accidental:$$[
      mark=@u"#";1
      mark=@u"b";-1
      raise fmt["invalid note '{}': the accidental must be '#' or 'b'";name]]
    octave_index:2]

  octave:parse_int_between[str name octave_index;"octave";0;8]
  midi:12*(octave+1)+semitone+accidental
  $.[or[midi<12;midi>119]
    raise fmt["invalid note '{}': pitch is outside C0 through B8";name]]
  440.0*2^((midi-69)/12.0)}

parse_duration:{[value;tempo;token]
  pieces:split[value;"."]
  dotted:#pieces=2
  $.[or[#pieces>2;and[dotted;#pieces 1>0]]
    raise fmt["invalid duration in '{}': use 1, 2, 4, 8, 16, 32, optionally followed by '.'";token]]
  denominator:parse_int_value[pieces 0;"duration"]
  $.[not has?[(1;2;4;8;16;32);denominator]
    raise fmt["invalid duration in '{}': expected 1, 2, 4, 8, 16, or 32";token]]
  beats:4.0/denominator
  $[dotted;1.5*beats;beats]*60.0/tempo}

parse_event:{[token;tempo;wave;volume;attack;release]
  pieces:split[token;"/"]
  $.[not[#pieces=2]
    raise fmt["invalid event '{}': expected NOTES/DURATION, for example C4/4 or C4+E4+G4/2";token]]

  pitches:pieces 0
  $.[#pitches=0;raise fmt["invalid event '{}': missing a note or R";token]]
  seconds:parse_duration[pieces 1;tempo;token]
  frequencies:$[pitches="R";();map[split[pitches;"+"];note_frequency]]

  (`token:token;
   `seconds:seconds;
   `frequencies:frequencies;
   `wave:wave;
   `volume:volume;
   `attack:attack;
   `release:release)}

score_tokens:{[source]
  lines:split[source;"\n"]
  token_lines:map[lines;{split[(split[x;"//";`max:1])0]}]
  fold[token_lines;{x,y};()]}

parse_score:{[source]
  tempo:120
  wave:"sine"
  volume:0.75
  attack:0.008
  release:0.05
  events:()
  tokens:score_tokens source

  N[#tokens;
    token:tokens _n
    directive:split[token;"=";`max:1]
    $[#directive=2;
      [name:directive 0
       value:directive 1
       $.[#value=0;raise fmt["directive '{}' is missing a value";name]]
       $$[
         name="tempo";tempo:parse_int_between[value;"tempo";20;400]
         name="wave";[
           $.[not has?[wave_names;value]
             raise fmt["invalid wave '{}': expected sine, square, saw, or triangle";value]]
           wave:value]
         name="volume";volume:parse_float_between[value;"volume";0.0;1.0]
         name="attack";attack:parse_float_between[value;"attack";0.0;1.0]
         name="release";release:parse_float_between[value;"release";0.0;1.0]
         raise fmt["unknown directive '{}': expected tempo, wave, volume, attack, or release";name]]];
      [event:parse_event[token;tempo;wave;volume;attack;release]
       events:events,(,event)]]]

  $.[#events=0;raise "score contains no note or rest events"]
  events}

oscillator:{[wave;frequency;times]
  cycles:frequency*times
  $$[
    wave="sine";sin[tau*cycles]
    wave="square";sgn sin[tau*cycles]
    wave="saw";2.0*(cycles%1.0)-1.0
    wave="triangle";1.0-4.0*abs[(cycles+0.25)%1.0-0.5]
    raise fmt["unsupported oscillator wave '{}'";wave]]}

synthesize_event:{[event;sample_rate]
  sample_count:max[1;int round[event`seconds*sample_rate]]
  frequencies:event`frequencies
  $[#frequencies=0;@r repeat[0.0;sample_count]]

  times:(range[0;sample_count]+0.0)/sample_rate
  signal:repeat[0.0;sample_count]
  N[#frequencies;
    signal:signal+oscillator[event`wave;frequencies _n;times]]
  signal:signal/#frequencies

  attack_samples:max[1;int round[event`attack*sample_rate]]
  release_samples:max[1;int round[event`release*sample_rate]]
  envelope:range[0;sample_count]|map{
    max[0.0;min[1.0;x/attack_samples;(sample_count-1-x)/release_samples]]}
  event`volume*signal*envelope}

synthesize:{[events;sample_rate]
  $.[or[sample_rate<8000;sample_rate>192000]
    raise "sample rate must be between 8000 and 192000 Hz"]
  chunks:map[events;{synthesize_event[x;sample_rate]}]
  fold[chunks;{x,y};()]}

le16:{[value]
  (value%256;(int floor[value/256])%256)}

le32:{[value]
  (value%256;
   (int floor[value/256])%256;
   (int floor[value/65536])%256;
   (int floor[value/16777216])%256)}

pcm16le:{[sample]
  clipped:max[-1.0;min[1.0;sample]]
  value:int round[32767.0*clipped]
  unsigned:$[value<0;value+65536;value]
  le16 unsigned}

wav_bytes:{[samples;sample_rate;gain]
  $.[or[gain<0.0;gain>1.0];raise "gain must be between 0 and 1"]
  pcm:flatten map[samples*gain;pcm16le]
  data_size:#pcm
  byte_rate:sample_rate*2
  encode["RIFF";"utf-8"],
    le32[36+data_size],
    encode["WAVEfmt ";"utf-8"],
    le32[16],
    le16[1],
    le16[1],
    le32[sample_rate],
    le32[byte_rate],
    le16[2],
    le16[16],
    encode["data";"utf-8"],
    le32[data_size],
    pcm}

write_wav:{[path;samples;sample_rate;gain]
  bytes:wav_bytes[samples;sample_rate;gain]
  stream:open[path;`write:T;`create:T;`truncate:T]
  write[stream;bytes]
  close stream
  #bytes}

render_score:{[source;path;sample_rate;gain]
  events:parse_score source
  samples:synthesize[events;sample_rate]
  byte_count:write_wav[path;samples;sample_rate;gain]
  (`path:path;
   `events:#events;
   `samples:#samples;
   `seconds:#samples/sample_rate;
   `bytes:byte_count)}

(`parse_score:parse_score;
 `synthesize:synthesize;
 `wav_bytes:wav_bytes;
 `write_wav:write_wav;
 `render_score:render_score)
