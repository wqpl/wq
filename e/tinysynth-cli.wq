// Command-line wrapper for e/tinysynth.wq.

synth:@i"tinysynth.wq"
render_score:synth`render_score

positive_sample_rate:{[value]
  parsed:@t int value
  $.[not[parsed 0=`ok];raise "sample rate must be an int"]
  rate:parsed 1
  $.[or[rate<8000;rate>192000];raise "sample rate must be between 8000 and 192000 Hz"]
  rate}

unit_gain:{[value]
  parsed:@t float value
  $.[not[parsed 0=`ok];raise "gain must be a number"]
  gain:parsed 1
  $.[or[gain<0.0;gain>1.0];raise "gain must be between 0 and 1"]
  gain}

spec:(
  `name:"wq e/tinysynth-cli.wq --";
  `version:"1.0";
  `about:"Render a TinySynth score as a mono 16-bit PCM WAV file.";
  `args:(
    (`name:`input;`kind:`positional;`required:T;`value_name:"SCORE";`help:"TinySynth score file");
    (`name:`output;`kind:`positional;`default:"out.wav";`value_name:"WAV";`help:"output path (default: out.wav)");
    (`name:`sample_rate;`kind:`option;`short:@u"r";`parse:positive_sample_rate;`default:44100;`value_name:"HZ";`help:"sample rate from 8000 through 192000 (default: 44100)");
    (`name:`gain;`kind:`option;`short:@u"g";`parse:unit_gain;`default:0.85;`value_name:"LEVEL";`help:"master gain from 0 through 1 (default: 0.85)");
    (`name:`quiet;`kind:`flag;`short:@u"q";`help:"do not print the render summary")))

options:cliargs[spec]`args

read_score:{[path]
  stream:open path
  bytes:read stream
  close stream
  decode[bytes;"utf-8"]}

source:read_score options`input
result:render_score[source;options`output;options`sample_rate;options`gain]

$.[not options`quiet
  echo fmt[
    "wrote {} bytes to {} ({} events, {} seconds, {} Hz)";
    result`bytes;
    result`path;
    result`events;
    round[result`seconds;2];
    options`sample_rate]]
