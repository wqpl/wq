// Deque backed by a circular buffer.
make_deque:{[]
  // mutable state
  data:alloc 4;head:0;tail:0;sz:0/* number of elements */;cap:4/* ring buffer capacity */
  // -- private --
  check:'{[]$.[or[cap<4;sz<0];raise"deque invariant: bad cap or size"]
    $.[or[sz>cap;or[head<0;head>=cap]];raise"deque invariant: bad head or size"]
    $.[or[tail<0;tail>=cap];raise"deque invariant: bad tail"]
    $.[not[tail=((head+sz)%cap)];raise"deque invariant: bad tail position"]}
  grow:'{[]check[];old_data:data;old_cap:cap;old_sz:sz;new_cap:old_cap*2;new_data:alloc new_cap
    i:head;j:0;N[old_sz;new_data j:old_data i;i:(i+1)%old_cap;j+:1]
    data:new_data;cap:new_cap;head:0;tail:old_sz;check[]}
  shrink:'{[]check[];old_sz:sz;old_cap:cap
    $.[old_sz>=old_cap/%4;@r()];new_cap:max[old_cap/%2;4]
    $.[new_cap<old_sz;new_cap:old_sz];$.[new_cap>=old_cap;@r()]
    new_data:alloc new_cap;i:head;j:0
    N[old_sz;new_data j:data i;i:(i+1)%old_cap;j+:1]
    data:new_data;cap:new_cap;head:0;tail:old_sz;check[]}
  // -- public --
  push_back:'{[val]check[];$.[sz=cap;grow[]];data tail:val;tail:(tail+1)%cap;sz+:1;check[]}
    push_front:'{[val]check[];$.[sz=cap;grow[]];head:(head-1+cap)%cap;data head:val;sz+:1;check[]}
  pop_back:'{[]check[];$.[sz=0;raise"pop on empty deque"];tail:(tail-1+cap)%cap;val:data tail
    sz-:1;$.[sz<cap/%4;shrink[]];check[];val}
  pop_front:'{[]check[];$.[sz=0;raise"pop on empty deque"];val:data head;head:(head+1)%cap
    sz-:1;$.[sz<cap/%4;shrink[]];check[];val}
  // get element by logical index (0 <= idx < sz). negative index counts from end
  get:'{[idx]check[];$.[idx<0;idx+:sz];$.[or[idx<0;idx>=sz];raise"index out of bounds"]
    data[(head+idx)%cap]}
    // set element by logical index
    set_:'{[idx;val]check[];$.[idx<0;idx+:sz];$.[or[idx<0;idx>=sz];raise"index out of bounds"]
    data[(head+idx)%cap]:val;check[]}
    deque_len:'{[]check[];sz};empty?:'{[]check[];sz=0};capacity:'{[]check[];cap}
  to_list:'{[]check[];res:alloc sz;i:0;N[sz;res i:get i;i+:1];res}
  state:'{[]check[];(`list:to_list[];`data:data;`head:head;`tail:tail;`sz:sz;`cap:cap)}
  // return methods as a dict
  (`push_back:push_back;`push_front:push_front;`pop_back:pop_back;`pop_front:pop_front;
    `get:get;`set:set_;`len:deque_len;`empty?:empty?;`capacity:capacity;`to_list:to_list;
    `state:state;`check:check)}
make_deque
