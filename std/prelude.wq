assert:{[x;msg]$.[not x;raise["assertion failed: ",msg]]}

flip:{[f]{[x;y]f[y;x]}}
tap:{[f;x]f x;x}
apply:{[xs;f]f xs}
eq0:{zipw[inf;{x=y};x;y]}

enlist:{[x],x}
first:{[list]list 0}
last:{[list]list[-1]}
take:{[n;list]list[0..n]}
drop:{[n;list]list[n..#list]}

prod:{[xs]fold[{x*y};xs]}

repeat:{[s;n]acc:();N[n;acc:acc,s];acc}
replicate:{[f;n]N[#(l:alloc n);l[_n]:f[]];l}
delta:{[x]$.[#x<=1;@r x];t:alloc(#x-1);N[#t;t[_n]:x[_n+1]-x[_n]];t}
